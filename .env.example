# Environment Variables — Copy this to .env and fill in values
# NEVER commit the actual .env file — it is gitignored

# Google AI Studio API key (free at aistudio.google.com)
# Used for: Gemini text-embedding-004 (embeddings) + Gemini 2.0 Flash (LLM)
GEMINI_API_KEY=your_google_ai_studio_api_key_here

# CoinGecko API (free tier — no key required, but rate-limited to 30 req/min)
# Leave blank to use public API
COINGECKO_API_KEY=

# Alpha Vantage (free tier — 25 requests/day, 5 req/min)
# Get key at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# NewsAPI (free tier — 100 requests/day, 30 days history)
# Get key at: https://newsapi.org/register
NEWS_API_KEY=your_newsapi_key_here

# AWS Configuration
# These should be configured via AWS CLI profile, not hardcoded here
# Run: aws configure --profile realtime-rag
AWS_REGION=us-east-1
AWS_PROFILE=realtime-rag

# Terraform state backend (S3 bucket for remote state — created manually before first deploy)
TF_STATE_BUCKET=your-terraform-state-bucket-name
TF_STATE_KEY=realtime-rag-lakehouse/terraform.tfstate
